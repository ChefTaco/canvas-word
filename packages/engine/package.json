{
  "name": "@hivemagnus/canvas-word-engine",
  "version": "1.0.0",
  "description": "Canvas-based Word-style document editor engine (maintained MIT fork of canvas-editor) with stable serialized element identities",
  "keywords": [
    "canvas-editor",
    "canvas",
    "editor",
    "word",
    "docx",
    "rich-text"
  ],
  "author": "ChefTaco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/canvas-word.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/ChefTaco/canvas-word/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/canvas-word/issues"
  },
  "type": "module",
  "sideEffects": true,
  "main": "./dist/canvas-word-engine.js",
  "module": "./dist/canvas-word-engine.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/canvas-word-engine.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICES.md",
    "notices",
    "UPSTREAM.md",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/finalize-types.mjs && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "vite-plugin-css-injected-by-js": "5.0.3"
  }
}
